# Optional — leave empty to process locally with the high-quality CPU fallback.
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=npjpz24ig6c47j

# Public URL of this app. Optional on Vercel when Blob is connected (GPU
# workers download the public blob URL). Required for GPU jobs on files
# larger than ~8 MB when hosting locally without Blob.
PUBLIC_BASE_URL=

# Vercel Blob. Automatically injected when a Blob store is connected to the
# Vercel project. Required in production so uploads skip the 4.5 MB function body limit.
BLOB_READ_WRITE_TOKEN=

# Optional overrides if ffmpeg/ffprobe are not the bundled static binaries.
# FFMPEG_PATH=
# FFPROBE_PATH=
