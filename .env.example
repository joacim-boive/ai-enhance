# Required for GPU jobs. On Vercel, enable this for Preview AND Production,
# then Redeploy. GPU UNSET means this deployment cannot see the key.
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=tbsk82cmm6azwh

# Cloudflare R2 (S3 API). Required on Vercel for private GB masters.
# The GPU worker never receives these secrets — only short-lived presigned URLs.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Optional. Set to eu if the bucket is in a jurisdiction-specific endpoint.
# R2_JURISDICTION=eu

# Signs the httpOnly session cookie that gates /api/media. Required on Vercel.
SESSION_SECRET=

# Public URL of this app. Used so the GPU worker can fetch the public sample.
# User masters use presigned R2 GET URLs instead.
PUBLIC_BASE_URL=

# Optional overrides if ffmpeg/ffprobe are not the bundled static binaries.
# FFMPEG_PATH=
# FFPROBE_PATH=
