# Required for GPU jobs. On Vercel, enable this for Preview AND Production,
# then Redeploy. GPU UNSET means this deployment cannot see the key.
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=tbsk82cmm6azwh

# Public URL of this app. Optional on Vercel when Blob is connected (GPU
# workers download the public blob URL). Required for GPU jobs on files
# larger than ~8 MB when hosting locally without Blob.
PUBLIC_BASE_URL=

# Vercel Blob. Connecting a store injects BLOB_STORE_ID and
# BLOB_WEBHOOK_PUBLIC_KEY (OIDC). BLOB_READ_WRITE_TOKEN is optional fallback.
BLOB_STORE_ID=
BLOB_WEBHOOK_PUBLIC_KEY=
BLOB_READ_WRITE_TOKEN=

# Optional overrides if ffmpeg/ffprobe are not the bundled static binaries.
# FFMPEG_PATH=
# FFPROBE_PATH=
